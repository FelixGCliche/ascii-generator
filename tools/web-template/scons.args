# SCons args for the custom Godot web export template, built in CI by
# .github/actions/build-web-template (needed to keep index.wasm under Cloudflare's 25 MiB limit).
#
# Format: one key=value per line; '#' starts a comment. platform, target and threads are set
# by the action. Changing this file invalidates the CI template cache (triggers a rebuild).
# Delete this file (or empty it) to export with the stock template.
#
# This profile is for a 2D/UI-only project. A 3D project must remove disable_3d and the
# 3D/physics module lines below (or start from an empty file).
# Options: https://docs.godotengine.org/en/4.7/engine_details/development/compiling/optimizing_for_size.html

# Build settings
production=yes
debug_symbols=no
optimize=size_extra
lto=full
deprecated=no

# Engine features
disable_3d=yes
disable_physics_2d=yes
disable_navigation_2d=yes

# Text: fallback server only (no RTL/complex scripts or ligatures)
module_text_server_adv_enabled=no
module_text_server_fb_enabled=yes

# Modules not used by a 2D image-processing UI app
module_astcenc_enabled=no
module_basis_universal_enabled=no
module_betsy_enabled=no
module_camera_enabled=no
module_csg_enabled=no
module_cvtt_enabled=no
module_dds_enabled=no
module_enet_enabled=no
module_etcpak_enabled=no
module_fbx_enabled=no
module_glslang_enabled=no
module_gltf_enabled=no
module_godot_physics_2d_enabled=no
module_godot_physics_3d_enabled=no
module_gridmap_enabled=no
module_hdr_enabled=no
module_interactive_music_enabled=no
module_jolt_physics_enabled=no
module_jsonrpc_enabled=no
module_ktx_enabled=no
module_lightmapper_rd_enabled=no
module_meshoptimizer_enabled=no
module_mobile_vr_enabled=no
module_mp3_enabled=no
module_msdfgen_enabled=no
module_multiplayer_enabled=no
module_navigation_2d_enabled=no
module_navigation_3d_enabled=no
module_noise_enabled=no
module_objectdb_profiler_enabled=no
module_ogg_enabled=no
module_openxr_enabled=no
module_raycast_enabled=no
module_theora_enabled=no
module_tinyexr_enabled=no
module_upnp_enabled=no
module_vhacd_enabled=no
module_vorbis_enabled=no
module_webrtc_enabled=no
module_websocket_enabled=no
module_webxr_enabled=no
module_xatlas_unwrap_enabled=no
